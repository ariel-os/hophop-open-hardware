(version 1)
# JLCPCB multilayer ENIG capabilities, checked 2026-09-11:
# https://jlcpcb.com/capabilities/pcb-capabilities
# https://jlcpcb.com/impedance (JLC06161H-7628)
# 0.10 mm trace/space; default 0.15 mm tracks, 0.45/0.20 mm vias.
# 0.40/0.20 mm vias are available for dense fanout (extra fab cost).
(rule "Through vias only"
 (constraint disallow blind_via buried_via micro_via))
(rule "Keep reference planes free of signal tracks"
 (condition "A.NetName != 'GND' && (A.Layer == 'In1.Cu' || A.Layer == 'In4.Cu')")
 (constraint disallow track))
(rule "Via drill and annular ring"
 (condition "A.Type == 'Via'")
 (constraint hole_size (min 0.2mm))
 (constraint via_diameter (min 0.4mm) (opt 0.45mm))
 (constraint annular_width (min 0.1mm)))
(rule "Via drill to copper"
 (condition "A.Type == 'Via'")
 (constraint hole_clearance (min 0.2mm)))
(rule "PTH to track"
 (condition "A.Pad_Type == 'Through-hole' && B.Type == 'Track'")
 (constraint hole_clearance (min 0.28mm)))
(rule "Inner PTH drill to copper"
 (layer inner)
 (condition "A.Pad_Type == 'Through-hole'")
 (constraint hole_clearance (min 0.3mm)))
(rule "PTH drill spacing"
 (condition "A.Pad_Type == 'Through-hole' && B.Pad_Type == 'Through-hole'")
 (constraint hole_to_hole (min 0.45mm)))
(rule "Castellation drill spacing"
 (condition "A.memberOfFootprint('J60*') && B.memberOfFootprint('J60*')")
 (constraint hole_to_hole (min 0.5mm)))
(rule "No open vias in SMD solder lands"
 (condition "A.Type == 'Via' && B.Pad_Type == 'SMD'")
 (constraint physical_hole_clearance (min 0.2mm)))
# Board house allows 0.1 mm locally in BGA fanout. Keep standard SMD pads
# at 0.15 mm; U201/U202 are the 0.4/0.35 mm pitch BGA exceptions.
(rule "SMD pad spacing"
 (condition "A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD'")
 (constraint clearance (min 0.15mm)))
(rule "BGA pad spacing"
 (condition "(A.memberOfFootprint('U201') && B.memberOfFootprint('U201')) || (A.memberOfFootprint('U202') && B.memberOfFootprint('U202'))")
 (constraint clearance (min 0.09mm)))
